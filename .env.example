# Copy to .env for local overrides. Never commit .env.
# Defaults keep every real provider OFF. CI does not set LIVE_MODE.

MIGRATION_EVAL_LOG_LEVEL=INFO
MIGRATION_EVAL_MAX_ATTEMPTS=3
MIGRATION_EVAL_BACKOFF_CAP_S=0.2
MIGRATION_EVAL_POLICY=config/policy.yaml
MIGRATION_EVAL_PRICES=config/prices.yaml
MIGRATION_EVAL_GOLDEN=data/golden_tickets.json
MIGRATION_EVAL_CANARY=config/canary.yaml
MIGRATION_EVAL_CALENDAR=config/deprecation_calendar.yaml
MIGRATION_EVAL_CASSETTE_RECORD=0

# Optional chat-completions HTTP compare. Off unless LIVE_MODE=1.
# Leave the price fields empty in the repo. Set them in the environment when you run.
# The same per-million rate is applied to both models. Cassettes are written under var/.
LIVE_MODE=0
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_OLD=
LLM_MODEL_NEW=
MAX_LIVE_SPEND_USD=
LLM_USD_PER_M_INPUT=
LLM_USD_PER_M_OUTPUT=
LLM_PRICE_DATE=

# Platform-migration chapter. Defaults stay on the local fake provider.
# MLMIG_PROVIDER=real and MLMIG_CASSETTE_RECORD=1 raise before any socket.
MLMIG_LOG_LEVEL=INFO
MLMIG_PROVIDER=fake
MLMIG_MAX_ATTEMPTS=3
MLMIG_BASE_DELAY_SECONDS=0.05
MLMIG_BACKOFF_CAP_SECONDS=0.5
MLMIG_CASSETTE_PATH=
MLMIG_CASSETTE_RECORD=0
