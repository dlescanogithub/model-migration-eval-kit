# Copy to .env for local overrides. Never commit .env.
# Defaults keep every real provider OFF. CI does not need any of these.

MIGRATION_EVAL_LOG_LEVEL=INFO
MIGRATION_EVAL_ENABLE_LIVE=0
MIGRATION_EVAL_LIVE_BASE_URL=
MIGRATION_EVAL_LIVE_API_KEY=
MIGRATION_EVAL_LIVE_MODEL=
MIGRATION_EVAL_MAX_ATTEMPTS=3
MIGRATION_EVAL_BACKOFF_CAP_S=0.2
MIGRATION_EVAL_POLICY=config/policy.yaml
MIGRATION_EVAL_PRICES=config/prices.yaml
MIGRATION_EVAL_GOLDEN=data/golden_tickets.json
MIGRATION_EVAL_CANARY=config/canary.yaml
MIGRATION_EVAL_CALENDAR=config/deprecation_calendar.yaml
MIGRATION_EVAL_CASSETTE_RECORD=0
